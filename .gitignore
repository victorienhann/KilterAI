# Whitelist approach: ignore everything by default, then explicitly un-ignore
# only what should be tracked - .py source files, requirements.txt, this file,
# and an empty resources/ folder skeleton (structure only, never its data:
# databases, built datasets, trained models, downloaded board images).
*
!*/

# Directories that must stay fully excluded even though "*" alone would let
# git traverse into them looking for *.py to un-ignore below.
.venv/
.idea/
.vscode/
__pycache__/

!*.py
!requirements.txt
!.gitignore

!resources/databases/.gitkeep
!resources/datasets/.gitkeep
!resources/images/.gitkeep
!resources/models/.gitkeep
